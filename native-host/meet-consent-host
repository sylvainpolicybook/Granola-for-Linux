#!/usr/bin/env python3
# Chrome native-messaging relay between the Granola Companion extension and the desktop app's Unix socket.
import hashlib, os, socket, struct, sys, threading

home = os.path.expanduser("~")
sock_path = "/tmp/granola-meet-consent-%s.sock" % hashlib.sha256(home.encode()).hexdigest()[:12]

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sock_path)
out = sys.stdout.buffer
inp = sys.stdin.buffer
lock = threading.Lock()


def to_chrome():
    for line in s.makefile("rb"):
        line = line.strip()
        if not line:
            continue
        with lock:
            out.write(struct.pack("=I", len(line)) + line)
            out.flush()
    os._exit(0)


threading.Thread(target=to_chrome, daemon=True).start()

while True:
    hdr = inp.read(4)
    if len(hdr) < 4:
        break
    (n,) = struct.unpack("=I", hdr)
    s.sendall(inp.read(n) + b"\n")
